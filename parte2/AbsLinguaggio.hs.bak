    | TPtr Type
  deriving (C.Eq, C.Ord, C.Show, C.Read)

data Block = BBlock [Stmt]
  deriving (C.Eq, C.Ord, C.Show, C.Read)

data Stmt
    = SBlock Block
    | SAssign Exp Exp
    | SCall Ident [Exp]
    | SReturn Exp
    | SReturnV
    | SDecl TopDecl
    | SIf Exp Block
    | SIfElse Exp Block Block
    | SWhile Exp Block
  deriving (C.Eq, C.Ord, C.Show, C.Read)

data Exp
    = EOr Exp Exp
    | EAnd Exp Exp
    | EEq Exp Exp
    | ENeq Exp Exp
    | ELt Exp Exp
    | ELe Exp Exp
    | EGt Exp Exp
    | EGe Exp Exp
    | EAdd Exp Exp
