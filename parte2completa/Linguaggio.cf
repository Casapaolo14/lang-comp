entrypoints Program ;

Prog. Program ::= [TopDecl] ;

-- variabili globali
DVar.     TopDecl ::= "var" Ident ":" Type ";" ;
DVarInit. TopDecl ::= "var" Ident ":" Type "=" Exp ";" ;

separator TopDecl "" ;

-- procedure/funzioni
DProc.   TopDecl ::= "proc" Ident "(" [Param] ")" ":" Type Block ;

Par.     Param ::= Intent Ident ":" Type ;
separator Param "," ;

-- parametri
IIn.     Intent ::= ;
IRef.    Intent ::= "ref" ;

-- tipi
TInt.    Type ::= "int" ;
TBool.   Type ::= "bool" ;
TReal.   Type ::= "real" ;
TChar.   Type ::= "char" ;
TStr.    Type ::= "string" ;
TVoid.   Type ::= "void" ;
TArr.    Type ::= "[" Integer ".." Integer "]" Type ;
TPtr.    Type ::= "c_ptr" "(" Type ")" ;

-- blocchi di codice
BBlock.  Block ::= "{" [Stmt] "}" ;
separator Stmt "" ;

-- istruzioni
SBlock.  Stmt ::= Block ;
SAssign. Stmt ::= Exp "=" Exp ";" ;
SCall.   Stmt ::= Ident "(" [Exp] ")" ";" ;
SReturn. Stmt ::= "return" Exp ";" ;
SReturnV.Stmt ::= "return" ";" ;
SDecl.   Stmt ::= TopDecl ;
separator Exp "," ;

-- controlli
SIf.     Stmt ::= "if" Exp Block ;
SIfElse. Stmt ::= "if" Exp Block "else" Block ;
SWhile.  Stmt ::= "while" Exp Block ;
SDoWhile. Stmt ::= "do" Block "while" Exp ";" ;
SFor.     Stmt ::= "for" Ident "in" Exp ".." Exp Block ;
SBreak.    Stmt ::= "break" ";" ;
SContinue. Stmt ::= "continue" ";" ;
SOpAssign. Stmt ::= Exp AssignOp Exp ";" ;

AAdd. AssignOp ::= "+=" ;
ASub. AssignOp ::= "-=" ;
AMul. AssignOp ::= "*=" ;

-- espressione condizionale (livello di precedenza più basso)
EIf.  Exp  ::= "if" Exp "then" Exp "else" Exp ;

-- operatori logici
EOr.  Exp1 ::= Exp1 "||" Exp2 ;
EAnd. Exp2 ::= Exp2 "&&" Exp3 ;

-- operatori di confronto
EEq.  Exp3 ::= Exp4 "==" Exp4 ;
ENeq. Exp3 ::= Exp4 "!=" Exp4 ;
ELt.  Exp3 ::= Exp4 "<"  Exp4 ;
ELe.  Exp3 ::= Exp4 "<=" Exp4 ;
EGt.  Exp3 ::= Exp4 ">"  Exp4 ;
EGe.  Exp3 ::= Exp4 ">=" Exp4 ;

-- operatori aritmetici
EAdd. Exp4 ::= Exp4 "+" Exp5 ;
ESub. Exp4 ::= Exp4 "-" Exp5 ;
EMul. Exp5 ::= Exp5 "*" Exp6 ;
EDiv. Exp5 ::= Exp5 "/" Exp6 ;

-- operatori unari
ENeg.   Exp6 ::= "-" Exp6 ;
ENot.   Exp6 ::= "!" Exp6 ;
EDeref. Exp6 ::= "*" Exp6 ;
EAddr.  Exp6 ::= "c_ptrTo" "(" Exp ")" ;

-- indice array e chiamata di funzione
EIdx.  Exp7 ::= Exp7 "[" Exp "]" ;
ECall. Exp7 ::= Ident "(" [Exp] ")" ;

-- espressioni
EVar.   Exp8 ::= Ident ;
EInt.   Exp8 ::= Integer ;
EReal.  Exp8 ::= Double ;
EChar.  Exp8 ::= Char ;
EStr.   Exp8 ::= String ;
ETrue.  Exp8 ::= "true" ;
EFalse. Exp8 ::= "false" ;
EArr.   Exp8 ::= "[" [Exp] "]" ;

-- gestione parentesi
coercions Exp 8 ;

-- gestione dei commenti
comment "//" ;
comment "/*" "*/" ;